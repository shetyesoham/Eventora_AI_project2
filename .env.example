# ==========================================
# EVENTORA AI ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
PORT=8000

# Google Gemini AI API Key (Required for full Generative AI features)
# Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (PostgreSQL & Auth & Storage)
# Get from https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Google Maps Platform (Optional: For venue and vendor geocoding & mapping)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Sarvam AI (Optional: For Indian-language speech-to-text and multilingual voice interactions)
SARVAM_API_KEY=your_sarvam_api_key_here

# JWT Authentication Secret
JWT_SECRET=eventora-ai-secure-token-secret-change-in-production

